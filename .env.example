# --- Required ---
DATABASE_URL=postgres://sdl:sdl@localhost:5432/sdl
# Public URL of the app (used in emailed links and the Xero callback)
APP_URL=http://localhost:3000
# Timezone used for "today", schedules and daily logs
APP_TIMEZONE=Australia/Sydney

# First admin login (created by `npm run db:seed` if no users exist)
ADMIN_EMAIL=admin@sdlcreations.com.au
ADMIN_PASSWORD=change-me-now
ADMIN_NAME=SDL Admin

# --- File storage ---
# Default stores uploads on local disk in ./uploads (fine for a VPS / Docker volume).
# FILE_STORAGE=database keeps them in Postgres instead (hosts without a permanent disk).
# For serverless hosting, use any S3-compatible bucket (Cloudflare R2, AWS S3, Supabase, Backblaze).
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=sdl-operations
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Email (optional) ---
# Without SMTP, the app gives you a copyable link + "open in email app" instead of sending.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=office@sdlcreations.com.au
# SMTP_PASS=
# EMAIL_FROM="SDL Creations <office@sdlcreations.com.au>"

# --- Xero (optional) ---
# Create a Web app at https://developer.xero.com/app/manage
# Redirect URI: <APP_URL>/api/xero/callback
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=
# XERO_SCOPES="openid profile email offline_access accounting.invoices accounting.contacts accounting.settings.read accounting.payments.read"
